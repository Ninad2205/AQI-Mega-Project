<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Indian AQI Calculator</title>
  <script src="script.js" defer></script>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gradient-to-r from-green-100 to-blue-200 min-h-screen flex flex-col items-center justify-center p-6">
  <div class="bg-white shadow-2xl rounded-2xl p-8 max-w-md w-full text-center">
    <h1 class="text-3xl font-bold text-blue-700 mb-6">Indian AQI Calculator</h1>
    <form id="aqiForm" class="space-y-4">
      <input type="text" id="latitude" placeholder="Latitude" class="w-full px-4 py-2 border rounded-lg">
      <input type="text" id="longitude" placeholder="Longitude" class="w-full px-4 py-2 border rounded-lg">
      <button type="submit" class="bg-blue-600 text-white px-6 py-2 rounded-lg hover:bg-blue-700 transition">Get AQI</button>
    </form>
    <div id="result" class="mt-6 text-lg font-semibold text-gray-800"></div>
    <div id="components" class="mt-4 text-sm text-gray-600"></div>
  </div>
</body>
</html>
