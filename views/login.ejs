<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>AQInow</title>
    <link rel="icon" type="image/png" href="/images/logo.png">

    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <style>
      html,
      body {
        height: 100%;
        background-color: #f5f5f5;
      }

      /* Navbar */
      .navbar {
        display: flex;
        justify-content: space-between;
        align-items: center;

        background-color: rgb(26, 41, 80);
        padding: 15px 20px;
        position: sticky;
        top: 0;
        z-index: 1000;
      }

      .nav-logo {
        display: flex;
        align-items: center;
        gap: 10px;
        padding-left: 2vh;
        font-size: 1.9rem;
        font-weight: bold;
        color: rgb(241, 241, 241);
      }

      .nav-logo img {
        width: 40px;
        height: 40px;
      }

      .nav-links {
        display: flex;
        gap: 20px;
        align-items: center;
      }

      .nav-links li a {
        color: #ffffff;
        text-decoration: none;
        font-size: 1rem;
        transition: color 0.3s ease;
      }

      .nav-links li a:hover {
        color: #000;
      }
      .navbar-toggler {
        border: none;
        outline: none;
      }

      /* Footer */
      footer {
        background-color: #1a2950;
        color: white;
        padding: 20px 0;
        text-align: center;
        font-size: 0.9rem;
      }

      .footer-links a {
        color: #ccc;
        text-decoration: none;
        margin: 0 8px;
      }

      .footer-links a:hover {
        text-decoration: underline;
      }
      @media (max-width: 768px) {
        .navbar {
          flex-direction: column;
          padding: 15px;
          min-height: 70px;
          padding-top: 10px;
          padding-bottom: 10px;
        }

        .nav-links {
          flex-direction: column;
          gap: 10px;
          margin-top: 15px;
        }

        .hero h1 {
          font-size: 2rem;
        }

        .hero p {
          font-size: 1rem;
        }

        .hero-btn {
          padding: 10px 20px;
          font-size: 1rem;
        }

        .aqi-cards {
          flex-direction: column;
          align-items: center;
        }

        .scale-box {
          flex: 0 1 100%;
          height: auto;
          padding: 20px;
        }

        .articles h2 {
          font-size: 2rem;
        }

        .pollution-sources ul {
          font-size: 1rem;
        }

        footer {
          font-size: 0.8rem;
        }
      }

      @media (max-width: 480px) {
        .nav-logo {
          font-size: 1.3rem;
        }

        .hero {
          height: 60vh;
        }

        .hero h1 {
          font-size: 1.6rem;
        }

        .hero p {
          font-size: 1rem;
        }

        .aqi-card {
          width: 80%;
          margin-bottom: 15px;
        }

        .pollution-sources ul {
          font-size: 1rem;
        }
      }

      .full-height-container {
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 15px;
      }

      .login-container {
        width: 100%;
        max-width: 400px;
        background: white;
        border-radius: 12px;
        padding: 30px;
        box-shadow: 0 0 12px rgba(0, 0, 0, 0.1);
      }

      .login-heading {
        font-size: 2rem;
        font-weight: bold;
        text-align: center;
        margin-bottom: 25px;
        background: linear-gradient(90deg, #0072ff, #b900b4);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
      }

      .form-control::placeholder {
        color: #ccc;
      }

      .login-btn {
        background: linear-gradient(90deg, #0072ff, #b900b4);
        color: white;
        border: none;
        border-radius: 8px;
        font-weight: 500;
        transition: 0.3s ease;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15);
      }

      .login-btn:hover {
        color: white;
        opacity: 0.85;
      }

      .toggle-password {
        position: absolute;
        right: 15px;
        top: 50%;
        transform: translateY(-50%);
        cursor: pointer;
        width: 24px;
        height: 24px;
      }

      .back-link {
        margin-top: 15px;
        display: block;
        text-align: center;
        color: #000000;
        cursor: pointer;
        font-size: 0.9rem;
      }

      .create-account {
        text-align: center;
        margin-top: 10px;
      }

      .create-account a {
        text-decoration: none;
        color: #3399ff;
        font-size: 0.9rem;
      }

      .create-account a:hover {
        text-decoration: underline;
      }

      /* Styling for flash messages */
      .flash-message {
        opacity: 1;
        transition: opacity 1s ease-in-out;
      }
      .flash-message {
        transition: all 0.6s ease;
        overflow: hidden;
      }
      .btn-back {
        background-color: black;
        border: none;
        border-radius: 8px;
        font-weight: 500;
        transition: 0.3s ease;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15);
      }
    </style>
  </head>
  <body>
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark sticky-top py-3">
      <div class="container-fluid">
        <div class="nav-logo d-flex align-items-center">
          <img
            src="../images/logo.png"
            alt="AQInow Logo"
            width="60"
            height="60"
          />
          <span class="ms-2 text-white fw-bold fs-4">AQInow</span>
        </div>

        <button
          class="navbar-toggler"
          type="button"
          data-bs-toggle="collapse"
          data-bs-target="#navbarNav"
        >
          <span class="navbar-toggler-icon"></span>
        </button>

        <div
          class="collapse navbar-collapse justify-content-end"
          id="navbarNav"
        >
          <ul class="navbar-nav nav-links">
            <li class="nav-item">
              <a class="nav-link text-white" href="/">Home</a>
            </li>
            <li class="nav-item">
              <a class="nav-link text-white" href="/dashboard">Air Quality</a>
            </li>
            <li class="nav-item">
              <a class="nav-link text-white" href="#contact">Contact</a>
            </li>
            <li class="nav-item">
              <a class="nav-link text-white" href="#help">Help</a>
            </li>
          </ul>
        </div>
      </div>
    </nav>

    <div class="container-fluid full-height-container">
      <div class="login-container">
        <h3 class="login-heading">Login</h3>
        <% if (messages && messages.length > 0) { %>
        <div class="alert alert-danger flash-message">
          <% messages.forEach(message => { %>
          <p><%= message %></p>
          <% }); %>
        </div>
        <% } %>

        <form action="/login" method="POST">
          <div class="mb-3">
            <input
              type="email"
              class="form-control"
              name="emailId"
              placeholder="Enter your email"
              required
            />
          </div>
          <div class="mb-3 position-relative">
            <input
              type="password"
              class="form-control"
              name="password"
              id="password"
              placeholder="Enter your password"
              required
            />
            <img
              src="https://cdn-icons-png.flaticon.com/512/159/159604.png"
              alt="Toggle Password"
              class="toggle-password"
              id="eyeIcon"
              onclick="togglePassword()"
            />
          </div>
          <button type="submit" class="btn login-btn w-100">Login</button>

          <!-- <div class="mt-3 text-center">
          <a href="javascript:history.back()" class="btn btn-secondary btn-sm">Back</a>
          <p class="mt-2">Don't have an account? <a href="/signup" class="text-primary">Create New</a></p>
        </div> -->
        </form>
        <!-- Links below the form -->
        <div class="mt-3 text-center">
          <a
            href="javascript:history.back()"
            class="btn btn-back btn-secondary btn-sm w-60"
            >Back</a
          >
          <p class="mt-2">
            Don't have an account?
            <a href="/signup" class="text-primary">Create New</a>
          </p>
        </div>
      </div>
    </div>

    <footer>
      <p class="mb-1">&copy; 2025 AQInow. All rights reserved.</p>
      <div class="footer-links">
        <a href="#" class="text-light text-decoration-none me-2">Privacy</a>|
        <a href="#" class="text-light text-decoration-none mx-2">Terms</a>|
        <a href="#" class="text-light text-decoration-none ms-2">Contact</a>
      </div>
    </footer>

    <script>
      function togglePassword() {
        const passwordField = document.getElementById("password");
        const eyeIcon = document.getElementById("eyeIcon");
        if (passwordField.type === "password") {
          passwordField.type = "text";
          eyeIcon.style.opacity = "0.6";
        } else {
          passwordField.type = "password";
          eyeIcon.style.opacity = "1";
        }
      }

      function goBack() {
        window.history.back();
      }

      // Fade out the flash message after 3 seconds
      window.onload = function () {
        const flashMessage = document.querySelector(".flash-message");
        if (flashMessage) {
          setTimeout(() => {
            flashMessage.style.opacity = "0";
            flashMessage.style.visibility = "hidden";
            flashMessage.style.height = "0";
            flashMessage.style.margin = "0";
            flashMessage.style.padding = "0";
          }, 3000);
        }
      };
    </script>
    <!-- Bootstrap JS and Popper.js (required for navbar toggler to work) -->
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.min.js"></script>
  </body>
</html>
