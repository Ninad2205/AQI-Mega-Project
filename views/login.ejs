<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Login</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet"/>
  <style>
    html, body {
      height: 100%;
      background-color: #f5f5f5;
    }

    .full-height-container {
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 15px;
    }

    .login-container {
      width: 100%;
      max-width: 400px;
      background: white;
      border-radius: 12px;
      padding: 30px;
      box-shadow: 0 0 12px rgba(0, 0, 0, 0.1);
    }

    .login-heading {
      font-size: 2rem;
      font-weight: bold;
      text-align: center;
      margin-bottom: 25px;
      background: linear-gradient(90deg, #0072ff, #b900b4);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .form-control::placeholder {
      color: #ccc;
    }

    .login-btn {
      background: linear-gradient(90deg, #0072ff, #b900b4);
      color: white;
      border: none;
      border-radius: 8px;
      font-weight: 500;
      transition: 0.3s ease;
      box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15);
    }

    .login-btn:hover {
      color: white;
      opacity: 0.85;
    }

    .toggle-password {
      position: absolute;
      right: 15px;
      top: 50%;
      transform: translateY(-50%);
      cursor: pointer;
      width: 24px;
      height: 24px;
    }

    .back-link {
      margin-top: 15px;
      display: block;
      text-align: center;
      color: #000000;
      cursor: pointer;
      font-size: 0.9rem;
    }

    .create-account {
      text-align: center;
      margin-top: 10px;
    }

    .create-account a {
      text-decoration: none;
      color: #3399ff;
      font-size: 0.9rem;
    }

    .create-account a:hover {
      text-decoration: underline;
    }

    /* Styling for flash messages */
    .flash-message {
      opacity: 1;
      transition: opacity 1s ease-in-out;
    }
    .flash-message {
      transition: all 0.6s ease;
      overflow: hidden;
    }
    .btn-back {
      background-color: black;
      border: none;
      border-radius: 8px;
      font-weight: 500;
      transition: 0.3s ease;
      box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15);
    }
    
  </style>
</head>
<body>
  <div class="container-fluid full-height-container">
    <div class="login-container">
      <h3 class="login-heading">Login</h3>
      <% if (messages && messages.length > 0) { %>
        <div class="alert alert-danger flash-message">
          <% messages.forEach(message => { %>
            <p><%= message %></p>
          <% }); %>
        </div>
      <% } %>
      
      <form action="/login" method="POST">
        <div class="mb-3">
          <input
            type="email"
            class="form-control"
            name="emailId"
            placeholder="Enter your email"
            required
          />
        </div>
        <div class="mb-3 position-relative">
          <input
            type="password"
            class="form-control"
            name="password"
            id="password"
            placeholder="Enter your password"
            required
          />
          <img
            src="https://cdn-icons-png.flaticon.com/512/159/159604.png"
            alt="Toggle Password"
            class="toggle-password"
            id="eyeIcon"
            onclick="togglePassword()"
          />
        </div>
        <button type="submit" class="btn login-btn w-100">Login</button>

        <!-- <div class="mt-3 text-center">
          <a href="javascript:history.back()" class="btn btn-secondary btn-sm">Back</a>
          <p class="mt-2">Don't have an account? <a href="/signup" class="text-primary">Create New</a></p>
        </div> -->

      </form>
      <!-- Links below the form -->
      <div class="mt-3 text-center">
        <a
          href="javascript:history.back()"
          class="btn btn-back btn-secondary btn-sm w-60"
          >Back</a
        >
        <p class="mt-2">
          Don't have an account? 
          <a href="/signup" class="text-primary">Create New</a>
        </p>
      </div>
    </div>
  </div>

  <script>
    function togglePassword() {
      const passwordField = document.getElementById("password");
      const eyeIcon = document.getElementById("eyeIcon");
      if (passwordField.type === "password") {
        passwordField.type = "text";
        eyeIcon.style.opacity = "0.6";
      } else {
        passwordField.type = "password";
        eyeIcon.style.opacity = "1";
      }
    }

    function goBack() {
      window.history.back();
    }

    // Fade out the flash message after 3 seconds
    window.onload = function () {
      const flashMessage = document.querySelector('.flash-message');
      if (flashMessage) {
        setTimeout(() => {
          flashMessage.style.opacity = '0';
          flashMessage.style.visibility = 'hidden';
          flashMessage.style.height = '0';
          flashMessage.style.margin = '0';
          flashMessage.style.padding = '0';
        }, 3000);
      }
    };
    
  </script>
</body>
</html>
