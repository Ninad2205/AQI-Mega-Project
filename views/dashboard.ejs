<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Dashboard</title>
  <link rel="icon" type="image/png" href="/images/logo.png">

  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
  <style>
    html, body {
      height: 100%;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
    }

    .content {
      flex: 1;
    }

    .navbar {
      background-color: rgb(26, 41, 80);
    }

    .nav-logo {
      display: flex;
      align-items: center;
      gap: 10px;
      padding-left: 2vh;
      font-size: 1.9rem;
      font-weight: bold;
      color: rgb(241, 241, 241);
    }

    .nav-logo img {
      width: 40px;
      height: 40px;
    }

    .nav-links {
      display: flex;
      gap: 20px;
      align-items: center;
    }

    .nav-links li a {
      color: #ffffff;
      text-decoration: none;
      font-size: 1rem;
      transition: color 0.3s ease;
    }

    .nav-links li a:hover {
      color: #ffc107;
    }

    .navbar-toggler {
      border: none;
      outline: none;
    }

    .logout-btn {
      background-color: #dc3545;
      color: white;
      border: none;
      padding: 6px 12px;
      border-radius: 5px;
      font-size: 0.9rem;
      transition: background-color 0.3s ease;
    }

    .logout-btn:hover {
      background-color: #c82333;
    }

    footer {
      background-color: #1a2950;
      color: white;
      padding: 20px 0;
      text-align: center;
      font-size: 0.9rem;
    }

    .footer-links a {
      color: #ccc;
      text-decoration: none;
      margin: 0 8px;
    }

    .footer-links a:hover {
      text-decoration: underline;
    }

    @media (max-width: 768px) {
      .nav-links {
        flex-direction: column;
        gap: 10px;
        margin-top: 15px;
      }

      .nav-logo {
        font-size: 1.5rem;
      }
    }
  </style>
</head>
<body>
  <!-- Navbar -->
  <nav class="navbar navbar-expand-lg navbar-dark sticky-top py-3">
    <div class="container-fluid">
      <div class="nav-logo d-flex align-items-center">
        <img src="../images/logo.png" alt="AQInow Logo"/>
        <span class="ms-2 text-white fw-bold fs-4">AQInow</span>
      </div>

      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="collapse navbar-collapse justify-content-end" id="navbarNav">
        <ul class="navbar-nav nav-links">
          <li class="nav-item"><a class="nav-link" href="/">Home</a></li>
          <li class="nav-item"><a class="nav-link" href="/dashboard">Air Quality</a></li>
          <li class="nav-item"><a class="nav-link" href="#contact">Contact</a></li>
          <li class="nav-item"><a class="nav-link" href="#help">Help</a></li>
        </ul>

        <!-- Calculate & Logout Buttons -->
        <div class="d-flex ms-3 align-items-center gap-2">
          <a href="http://127.0.0.1:5500/PYTHON%20PROGRAMMING/PYTHON%20PROGRAMMING/calculate.html" class="btn btn-warning text-dark fw-semibold">
            Calculate
          </a>
          <form action="/logout" method="POST">
            <button type="submit" class="logout-btn">Logout</button>
          </form>
        </div>
      </div>
    </div>
  </nav>

  <!-- Main content -->
  <div class="container content mt-5">
    <h2>Welcome, <%= user.name %>!</h2>
    <p>Your email: <%= user.email %></p>
    <p>Your ID: <%= user.id %></p>
  </div>

  <!-- Footer -->
  <footer>
    <p class="mb-1">&copy; 2025 AQInow. All rights reserved.</p>
    <div class="footer-links">
      <a href="#">Privacy</a> |
      <a href="#">Terms</a> |
      <a href="#">Contact</a>
    </div>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
