<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>AQInow</title>
    <link rel="icon" type="image/png" href="/images/logo.png" />
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-adapter-date-fns@3.0.0/dist/chartjs-adapter-date-fns.bundle.min.js"></script>
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
    />
    <style>
      body {
        font-family: "Segoe UI", sans-serif;
        background: linear-gradient(to right, #e0f7fa, #fff);
        padding: 2rem;
        text-align: center;
      }
      h1 {
        color: #00796b;
      }
      .city-container {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 2rem;
        margin-top: 2rem;
      }
      .aqi-box {
        padding: 1.5rem;
        border-radius: 12px;
        background-color: #ffffff;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        min-width: 250px;
      }
      .aqi-value {
        font-size: 2rem;
        font-weight: bold;
      }
      .good {
        color: green;
      }
      .moderate {
        color: orange;
      }
      .unhealthy {
        color: red;
      }
      .pollutants p {
        margin: 0.3rem 0;
      }

      html,
      body {
        height: 100%;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
      }

      .content {
        flex: 1;
      }

      .navbar {
        background-color: rgb(26, 41, 80);
      }

      .nav-logo {
        display: flex;
        align-items: center;
        gap: 10px;
        padding-left: 2vh;
        font-size: 1.9rem;
        font-weight: bold;
        color: rgb(241, 241, 241);
      }

      .nav-logo img {
        width: 40px;
        height: 40px;
      }

      .nav-links {
        display: flex;
        gap: 20px;
        align-items: center;
      }

      .nav-links li a {
        color: #ffffff;
        text-decoration: none;
        font-size: 1rem;
        transition: color 0.3s ease;
      }

      .nav-links li a:hover {
        color: #ffc107;
      }

      .navbar-toggler {
        border: none;
        outline: none;
      }

      .logout-btn {
        background-color: #dc3545;
        color: white;
        border: none;
        padding: 6px 12px;
        border-radius: 5px;
        font-size: 0.9rem;
        transition: background-color 0.3s ease;
      }

      .logout-btn:hover {
        background-color: #c82333;
      }

      footer {
        margin-top: 10px;
        background-color: #1a2950;
        color: white;
        padding: 20px 0;
        text-align: center;
        font-size: 0.9rem;
      }

      .footer-links a {
        color: #ccc;
        text-decoration: none;
        margin: 0 8px;
      }

      .footer-links a:hover {
        text-decoration: underline;
      }

      @media (max-width: 768px) {
        .nav-links {
          flex-direction: column;
          gap: 10px;
          margin-top: 15px;
        }

        .nav-logo {
          font-size: 1.5rem;
        }
      }
    </style>
  </head>
  <body>
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark sticky-top py-3">
      <div class="container-fluid">
        <div class="nav-logo d-flex align-items-center">
          <img src="../images/logo.png" alt="AQInow Logo" />
          <span class="ms-2 text-white fw-bold fs-4">AQInow</span>
        </div>

        <button
          class="navbar-toggler"
          type="button"
          data-bs-toggle="collapse"
          data-bs-target="#navbarNav"
        >
          <span class="navbar-toggler-icon"></span>
        </button>

        <div
          class="collapse navbar-collapse justify-content-end"
          id="navbarNav"
        >
          <ul class="navbar-nav nav-links">
            <li class="nav-item"><a class="nav-link" href="/">Home</a></li>
            <li class="nav-item">
              <a class="nav-link" href="/dashboard">Air Quality</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="#contact">Contact</a>
            </li>
            <li class="nav-item"><a class="nav-link" href="#help">Help</a></li>
          </ul>

          <!-- Logout Button -->
         <!-- Calculate & Logout Buttons -->
        <div class="d-flex ms-3 align-items-center gap-2">
          <a href="http://127.0.0.1:5500/PYTHON%20PROGRAMMING/PYTHON%20PROGRAMMING/calculate.html" class="btn btn-warning text-dark fw-semibold">
            Calculate
          </a>
          <form action="/logout" method="POST">
            <button type="submit" class="logout-btn">Logout</button>
          </form>
        </div>
        </div>
      </div>
    </nav>

    <!-- Main content -->
    <div class="container content mt-5">
      <h2>Welcome, <%= user.name %>!</h2>
      <p>Your email: <%= user.email %></p>
      <p>Your ID: <%= user.id %></p>
    </div>

    <h1>🌫️ Live AQI Data for Cities</h1>
    <div class="city-container" id="cityContainer"></div>

    <script>
      const API_KEY = "306f5a21f4611bca4f7a86231be36c38";
    
      const cities = [
        { name: "Pune", lat: 18.5204, lon: 73.8567 },
        { name: "Kolhapur", lat: 16.7050, lon: 74.2433 },
        { name: "Mumbai", lat: 19.0760, lon: 72.8777 },
        { name: "Ichalkaranji", lat: 16.6916, lon: 74.4608 },
        { name: "Sangli", lat: 16.8544, lon: 74.5815 }
      ];
    
      function calculateAQI_PM25(pm) {
        const breakpoints = [
          { cLow: 0.0, cHigh: 12.0, aqiLow: 0, aqiHigh: 50 },
          { cLow: 12.1, cHigh: 35.4, aqiLow: 51, aqiHigh: 100 },
          { cLow: 35.5, cHigh: 55.4, aqiLow: 101, aqiHigh: 150 },
          { cLow: 55.5, cHigh: 150.4, aqiLow: 151, aqiHigh: 200 },
          { cLow: 150.5, cHigh: 250.4, aqiLow: 201, aqiHigh: 300 },
          { cLow: 250.5, cHigh: 350.4, aqiLow: 301, aqiHigh: 400 },
          { cLow: 350.5, cHigh: 500.4, aqiLow: 401, aqiHigh: 500 }
        ];
    
        for (let bp of breakpoints) {
          if (pm >= bp.cLow && pm <= bp.cHigh) {
            return Math.round(
              ((bp.aqiHigh - bp.aqiLow) / (bp.cHigh - bp.cLow)) * (pm - bp.cLow) + bp.aqiLow
            );
          }
        }
        return 0;
      }
    
      function calculateAQI_PM10(pm) {
        const breakpoints = [
          { cLow: 0.0, cHigh: 54.0, aqiLow: 0, aqiHigh: 50 },
          { cLow: 55.0, cHigh: 154.0, aqiLow: 51, aqiHigh: 100 },
          { cLow: 155.0, cHigh: 254.0, aqiLow: 101, aqiHigh: 150 },
          { cLow: 255.0, cHigh: 354.0, aqiLow: 151, aqiHigh: 200 },
          { cLow: 355.0, cHigh: 424.0, aqiLow: 201, aqiHigh: 300 },
          { cLow: 425.0, cHigh: 504.0, aqiLow: 301, aqiHigh: 400 },
          { cLow: 505.0, cHigh: 604.0, aqiLow: 401, aqiHigh: 500 }
        ];
    
        for (let bp of breakpoints) {
          if (pm >= bp.cLow && pm <= bp.cHigh) {
            return Math.round(
              ((bp.aqiHigh - bp.aqiLow) / (bp.cHigh - bp.cLow)) * (pm - bp.cLow) + bp.aqiLow
            );
          }
        }
        return 0;
      }
    
      function calculateAQI_NO2(no2) {
        const breakpoints = [
          { cLow: 0.0, cHigh: 53.0, aqiLow: 0, aqiHigh: 50 },
          { cLow: 54.0, cHigh: 100.0, aqiLow: 51, aqiHigh: 100 },
          { cLow: 101.0, cHigh: 360.0, aqiLow: 101, aqiHigh: 150 },
          { cLow: 361.0, cHigh: 649.0, aqiLow: 151, aqiHigh: 200 },
          { cLow: 650.0, cHigh: 1249.0, aqiLow: 201, aqiHigh: 300 },
          { cLow: 1250.0, cHigh: 2049.0, aqiLow: 301, aqiHigh: 400 },
          { cLow: 2050.0, cHigh: 3049.0, aqiLow: 401, aqiHigh: 500 }
        ];
    
        for (let bp of breakpoints) {
          if (no2 >= bp.cLow && no2 <= bp.cHigh) {
            return Math.round(
              ((bp.aqiHigh - bp.aqiLow) / (bp.cHigh - bp.cLow)) * (no2 - bp.cLow) + bp.aqiLow
            );
          }
        }
        return 0;
      }
    
      // Calculate AQI based on each pollutant and return the maximum
      function calculateOverallAQI(pm25, pm10, no2, co, so2, o3) {
        const aqiPM25 = calculateAQI_PM25(pm25);
        const aqiPM10 = calculateAQI_PM10(pm10);
        const aqiNO2 = calculateAQI_NO2(no2);
        // Implement similar calculations for CO, SO2, and O3 based on CPCB breakpoints
        // Assume placeholder calculations for CO, SO2, and O3 for now
    
        const aqiCO = 0; // Placeholder
        const aqiSO2 = 0; // Placeholder
        const aqiO3 = 0; // Placeholder
    
        // Return the maximum AQI value
        return Math.max(aqiPM25, aqiPM10, aqiNO2, aqiCO, aqiSO2, aqiO3);
      }
    
      function getStatus(aqi) {
        if (aqi === 0) return { text: "Unavailable", class: "" };
        if (aqi <= 50) return { text: "Good", class: "good" };
        if (aqi <= 100) return { text: "Moderate", class: "moderate" };
        return { text: "Unhealthy", class: "unhealthy" };
      }
    
      async function fetchAQIData() {
        const cityContainer = document.getElementById("cityContainer");
        if (!cityContainer) return;
    
        for (let city of cities) {
          const response = await fetch(
            `https://api.openweathermap.org/data/2.5/air_pollution?lat=${city.lat}&lon=${city.lon}&appid=${API_KEY}`
          );
          const json = await response.json();
          const { pm2_5, pm10, no2, co, so2, o3 } = json.list[0].components;
          
          // Calculate the overall AQI based on the pollutants
          const aqi = calculateOverallAQI(pm2_5, pm10, no2, co, so2, o3);
          const status = getStatus(aqi);
    
          // Create city box with AQI
          const cityBox = document.createElement("div");
          cityBox.classList.add("aqi-box");
          cityBox.innerHTML = `
            <h3>${city.name}</h3>
            <p class="aqi-value ${status.class}">AQI: ${aqi}</p>
            <p class="${status.class}">${status.text}</p>
            <div class="pollutants">
              <p><strong>PM2.5:</strong> ${pm2_5} µg/m³</p>
              <p><strong>PM10:</strong> ${pm10} µg/m³</p>
              <p><strong>NO2:</strong> ${no2} µg/m³</p>
              <p><strong>CO:</strong> ${co} µg/m³</p>
              <p><strong>SO2:</strong> ${so2} µg/m³</p>
              <p><strong>O3:</strong> ${o3} µg/m³</p>
            </div>
          `;
          cityContainer.appendChild(cityBox);
        }
      }
    
      fetchAQIData();
    </script>
    
  <!-- Footer -->
  <footer>
    <p class="mb-1">&copy; 2025 AQInow. All rights reserved.</p>
    <div class="footer-links">
      <a href="#">Privacy</a> |
      <a href="#">Terms</a> |
      <a href="#">Contact</a>
    </div>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

  </body>
</html>
