<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Signup</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/images/logo.png">

    <!-- Minified Bootstrap CSS from CDN -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <style>
      /* Make the body cover the entire viewport */
      body,
      html {
        height: 100%;
        margin: 0;
        font-family: Arial, sans-serif;
      }

      /* Navbar */
      .navbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background-color: rgb(26, 41, 80);
        padding: 15px 20px;
        position: sticky;
        top: 0;
        z-index: 1000;
      }

      .nav-logo {
        display: flex;
        align-items: center;
        gap: 10px;
        padding-left: 2vh;
        font-size: 1.9rem;
        font-weight: bold;
        color: rgb(241, 241, 241);
      }

      .nav-logo img {
        width: 40px;
        height: 40px;
      }

      .nav-links {
        display: flex;
        gap: 20px;
        align-items: center;
      }

      .nav-links li a {
        color: #ffffff;
        text-decoration: none;
        font-size: 1rem;
        transition: color 0.3s ease;
      }

      .nav-links li a:hover {
        color: #000;
      }
      .navbar-toggler {
        border: none;
        outline: none;
      }

      /* Footer */
      footer {
        background-color: #1a2950;
        color: white;
        padding: 20px 0;
        text-align: center;
        font-size: 0.9rem;
      }

      .footer-links a {
        color: #ccc;
        text-decoration: none;
        margin: 0 8px;
      }

      .footer-links a:hover {
        text-decoration: underline;
      }

      @media (max-width: 768px) {
        .navbar {
          flex-direction: column;
          padding: 15px;
          min-height: 70px;
          padding-top: 10px;
          padding-bottom: 10px;
        }

        .nav-links {
          flex-direction: column;
          gap: 10px;
          margin-top: 15px;
        }

        .hero h1 {
          font-size: 2rem;
        }

        .hero p {
          font-size: 1rem;
        }

        .hero-btn {
          padding: 10px 20px;
          font-size: 1rem;
        }

        .aqi-cards {
          flex-direction: column;
          align-items: center;
        }

        .scale-box {
          flex: 0 1 100%;
          height: auto;
          padding: 20px;
        }

        .articles h2 {
          font-size: 2rem;
        }

        .pollution-sources ul {
          font-size: 1rem;
        }

        footer {
          font-size: 0.8rem;
        }
      }

      @media (max-width: 480px) {
        .nav-logo {
          font-size: 1.3rem;
        }

        .hero {
          height: 60vh;
        }

        .hero h1 {
          font-size: 1.6rem;
        }

        .hero p {
          font-size: 1rem;
        }

        .aqi-card {
          width: 80%;
          margin-bottom: 15px;
        }

        .pollution-sources ul {
          font-size: 1rem;
        }
      }

      .signup-container {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        height: 100vh;
        padding: 20px;
        background-color: white;
      }

      .signup-form {
        background: white;
        border-radius: 15px;
        padding: 30px;
        box-shadow: 0 0 12px rgba(0, 0, 0, 0.1);
        width: 100%;
        max-width: 700px;
      }

      h3.signup-heading {
        font-size: 2rem;
        font-weight: bold;
        text-align: center;
        margin-bottom: 25px;
        background: linear-gradient(90deg, #0072ff, #b900b4);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
      }

      .form-label {
        font-weight: 500;
      }

      .form-control:focus {
        border-color: #0072ff;
        box-shadow: none;
      }

      .btn-signup {
        background: linear-gradient(90deg, #0072ff, #b900b4);
        color: white;
        border: none;
        border-radius: 8px;
        font-weight: 500;
        transition: 0.3s ease;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15);
      }

      .btn-signup:hover {
        opacity: 0.8;
        color: white;
      }

      .input-group-text {
        background-color: #fff;
        border-left: none;
        cursor: pointer;
      }

      .input-group .form-control {
        border-right: none;
      }

      .input-group .form-control:focus {
        box-shadow: none;
      }

      .btn-back {
        background-color: black;
        border: none;
        border-radius: 8px;
        font-weight: 500;
        transition: 0.3s ease;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15);
      }

      @media (max-width: 768px) {
        h3.signup-heading {
          font-size: 1.5rem;
        }
      }

      .flash-message {
        transition: all 0.6s ease;
        overflow: hidden;
      }
    </style>
  </head>

  <body>
    <nav class="navbar navbar-expand-lg navbar-dark sticky-top py-3">
      <div class="container-fluid">
        <div class="nav-logo d-flex align-items-center">
          <img
            src="../images/logo.png"
            alt="AQInow Logo"
            width="60"
            height="60"
          />
          <span class="ms-2 text-white fw-bold fs-4">AQInow</span>
        </div>

        <button
          class="navbar-toggler"
          type="button"
          data-bs-toggle="collapse"
          data-bs-target="#navbarNav"
        >
          <span class="navbar-toggler-icon"></span>
        </button>

        <div
          class="collapse navbar-collapse justify-content-end"
          id="navbarNav"
        >
          <ul class="navbar-nav nav-links">
            <li class="nav-item">
              <a class="nav-link text-white" href="/">Home</a>
            </li>
            <li class="nav-item">
              <a class="nav-link text-white" href="/dashboard">Air Quality</a>
            </li>
            <li class="nav-item">
              <a class="nav-link text-white" href="#contact">Contact</a>
            </li>
            <li class="nav-item">
              <a class="nav-link text-white" href="#help">Help</a>
            </li>
          </ul>
        </div>
      </div>
    </nav>

    <div class="signup-container" style="margin-top: 5px">
      <div class="signup-form">
        <h3 class="signup-heading">Create Your Account</h3>

        <% if (messages && messages.length > 0) { %>
        <div class="alert alert-danger">
          <% messages.forEach(message => { %>
          <p><%= message %></p>
          <% }); %>
        </div>
        <% } %>

        <form action="/signup" method="POST">
          <div class="row">
            <div class="col-md-6 col-12 mb-3">
              <label for="firstName" class="form-label">First Name</label>
              <input
                type="text"
                class="form-control"
                name="firstName"
                required
                pattern="[A-Za-z]+"
                title="Please enter only alphabetic characters."
              />
            </div>
            <div class="col-md-6 col-12 mb-3">
              <label for="lastName" class="form-label">Last Name</label>
              <input
                type="text"
                class="form-control"
                name="lastName"
                required
                pattern="[A-Za-z]+"
                title="Please enter only alphabetic characters."
              />
            </div>
          </div>
          <div class="row">
            <div class="col-md-6 col-12 mb-3">
              <label for="emailId" class="form-label">Email</label>
              <input
                type="email"
                class="form-control"
                name="emailId"
                required
                pattern="^[a-zA-Z0-9._%+-]+@gmail\.com$"
                title="Please enter a valid Gmail address (example: user@gmail.com)"
              />
            </div>
            <div class="col-md-6 col-12 mb-3">
              <label for="password" class="form-label">Password</label>
              <div class="input-group">
                <input
                  type="password"
                  class="form-control"
                  name="password"
                  id="passwordInput"
                  required
                />
                <span class="input-group-text" id="togglePassword">
                  <i class="bi bi-eye-fill" id="toggleIcon"></i>
                </span>
              </div>
            </div>
          </div>
          <div class="row">
            <div class="col-md-6 col-12 mb-3">
              <label for="mobileNumber" class="form-label">Mobile Number</label>
              <input
                type="text"
                class="form-control"
                name="mobileNumber"
                required
                pattern="^\d{10}$"
                title="Please enter a valid 10-digit mobile number."
              />
            </div>
            <div class="col-md-6 col-12 mb-3">
              <label for="organizationName" class="form-label"
                >Organization Name</label
              >
              <input
                type="text"
                class="form-control"
                name="organizationName"
                required
                pattern="[A-Za-z\s]+"
                title="Please enter only alphabetic characters and spaces."
              />
            </div>
          </div>
          <button type="submit" class="btn btn-signup w-100">Sign Up</button>
        </form>

        <div class="mt-3 text-center">
          <a
            href="javascript:history.back()"
            class="btn btn-back btn-secondary btn-sm w-60"
            >Back</a
          >
          <p class="mt-2">
            Already have an account?
            <a href="/login" class="text-primary">Login</a>
          </p>
        </div>
      </div>
    </div>

    <footer style="margin-top: 10px">
      <p class="mb-1">&copy; 2025 AQInow. All rights reserved.</p>
      <div class="footer-links">
        <a href="#" class="text-light text-decoration-none me-2">Privacy</a>|
        <a href="#" class="text-light text-decoration-none mx-2">Terms</a>|
        <a href="#" class="text-light text-decoration-none ms-2">Contact</a>
      </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
      const togglePassword = document.getElementById("togglePassword");
      const passwordInput = document.getElementById("passwordInput");
      const toggleIcon = document.getElementById("toggleIcon");

      togglePassword.addEventListener("click", () => {
        const type =
          passwordInput.getAttribute("type") === "password"
            ? "text"
            : "password";
        passwordInput.setAttribute("type", type);
        toggleIcon.classList.toggle("bi-eye-fill");
        toggleIcon.classList.toggle("bi-eye-slash-fill");
      });

      window.onload = function () {
        const flashMessage = document.querySelector(".alert");
        if (flashMessage) {
          setTimeout(() => {
            flashMessage.style.opacity = "0";
            flashMessage.style.visibility = "hidden";
            flashMessage.style.height = "0";
            flashMessage.style.margin = "0";
            flashMessage.style.padding = "0";
          }, 3000);
        }

        const navbarLinks = document.querySelectorAll(".nav-links a");
        const navbarCollapse = document.getElementById("navbarNav");
        navbarLinks.forEach((link) => {
          link.addEventListener("click", () => {
            if (window.innerWidth < 768) {
              const bsCollapse =
                bootstrap.Collapse.getInstance(navbarCollapse) ||
                new bootstrap.Collapse(navbarCollapse, { toggle: false });
              bsCollapse.hide();
            }
          });
        });
      };
    </script>
  </body>
</html>
